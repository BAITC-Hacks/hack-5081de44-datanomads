{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse109.local/schema/candidate-dataset-manifest.v1.json",
  "title": "Pulse 109 CandidateDatasetManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "artifact_uri",
    "content_sha256",
    "record_count",
    "feedback_ids",
    "feedback_export_uri",
    "feedback_export_sha256",
    "candidate_model_version",
    "production_model_version",
    "frozen_evaluation_dataset_version",
    "frozen_evaluation_ticket_ids",
    "source_dataset_versions",
    "training_ticket_ids",
    "synthetic",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "candidate-dataset-manifest.v1"},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "artifact_uri": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "feedback_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "feedback_export_uri": {"type": "string", "minLength": 1},
    "feedback_export_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_model_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "production_model_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "frozen_evaluation_dataset_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "frozen_evaluation_ticket_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "source_dataset_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "training_ticket_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "synthetic": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
