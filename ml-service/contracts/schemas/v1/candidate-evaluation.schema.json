{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse109.local/schema/candidate-evaluation.v1.json",
  "title": "Pulse 109 CandidateEvaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "candidate_model_version", "production_model_version", "candidate_dataset_version", "evaluation_version", "policy_version", "offline_evaluation", "shadow_evaluation", "decision", "evaluated_at", "synthetic"],
  "properties": {
    "schema_version": {"const": "candidate-evaluation.v1"},
    "cycle_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidate_model_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "production_model_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidate_dataset_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "evaluation_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "offline_evaluation": {"$ref": "https://pulse109.local/schema/model-evaluation.v1.json"},
    "shadow_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "agreement_with_confirmed", "correction_rate_delta", "critical_regressions"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "agreement_with_confirmed": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "correction_rate_delta": {"type": ["number", "null"]},
        "critical_regressions": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,199}$"}},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "https://pulse109.local/schema/model-evaluation.v1.json#/$defs/metricValue"}},
        "blind_ab": {"enum": ["DISABLED", "ENABLED"]}
      }
    },
    "decision": {"enum": ["PENDING_HUMAN_DECISION", "PASS", "FAIL", "INSUFFICIENT_EVIDENCE"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "synthetic": {"type": "boolean"}
  }
}
