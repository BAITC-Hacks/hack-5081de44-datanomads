{
  "openapi": "3.0.3",
  "info": {
    "title": "Pulse 109 API contract",
    "version": "1.0.0",
    "description": "Machine-readable route index for the PostgreSQL-backed P0 baseline. Detailed request and response schemas live in core.openapi.yaml and ml.openapi.yaml."
  },
  "paths": {
    "/healthz": { "get": { "summary": "Liveness" } },
    "/readyz": {
      "get": {
        "summary": "Dependency and model artifact readiness",
        "responses": {
          "200": { "description": "Required dependencies are ready" },
          "503": { "description": "A dependency or model artifact is not ready" }
        }
      }
    },
    "/api/v1/audit": { "get": { "summary": "Privacy-safe audit log for managers and admins" } },
    "/api/v1/tickets": { "get": { "summary": "List tickets" }, "post": { "summary": "Create ticket" } },
    "/api/v1/tickets/{ticket_id}": { "get": { "summary": "Get ticket and prediction" } },
    "/api/v1/tickets/{ticket_id}/vector": { "delete": { "summary": "Delete one Qdrant vector" } },
    "/api/v1/tickets/{ticket_id}/pulse-state": { "put": { "summary": "Store human-confirmed Pulse state" } },
    "/api/v1/import": { "post": { "summary": "Import validated tickets into PostgreSQL and Qdrant" } },
    "/api/v1/datasets/provenance": { "get": { "summary": "Read synthetic, real and unassigned dataset counts" } },
    "/api/v1/tickets/{ticket_id}/relation-feedback": { "post": { "summary": "Confirm duplicate/repeat relation" } },
    "/api/v1/assist/preview": { "post": { "summary": "Assist preview" } },
    "/api/v1/analytics/overview": { "get": { "summary": "Analytics overview" } },
    "/api/v1/analytics/drilldown": { "get": { "summary": "Drill analytics metrics down to source tickets" } },
    "/api/v1/analytics/query": { "post": { "summary": "Validated analytics query" } },
    "/api/v1/analytics": { "get": { "summary": "Filtered analytics report slice" } },
    "/api/v1/taxonomy": { "get": { "summary": "Current regions, topics, services and available ticket filters" } },
    "/api/v1/retrieval/reindex": { "post": { "summary": "Queue a PostgreSQL-backed Qdrant reindex" } },
    "/api/v1/alerts": { "get": { "summary": "Alerts" } },
    "/api/v1/alerts/detect": { "post": { "summary": "Detect and persist region/topic anomaly alerts" } },
    "/api/v1/alerts/{alert_id}": { "get": { "summary": "Get alert detail and linked tickets" } },
    "/api/v1/alerts/{alert_id}/monitor": { "post": { "summary": "Take an observed signal under manager monitoring" } },
    "/api/v1/alerts/{alert_id}/ack": { "post": { "summary": "Acknowledge alert" } },
    "/api/v1/alerts/{alert_id}/close": { "post": { "summary": "Close alert" } },
    "/api/v1/forecast": { "get": { "summary": "Forecast demand, peaks and explicit capacity input status" } },
    "/api/v1/forecast/reforecast": { "post": { "summary": "Persist a rolling forecast version and compare it with the previous run" } },
    "/api/v1/reports": { "get": { "summary": "Reports" } },
    "/api/v1/learning/cycle": { "get": { "summary": "Collect learning feedback and inspect learning cycle" } },
    "/api/v1/learning/drift-triggers": { "get": { "summary": "List reviewable Data/ML drift evidence triggers" }, "post": { "summary": "Receive versioned drift evidence from Data/ML" } },
    "/api/v1/learning/drift-triggers/{evidence_id}/review": { "post": { "summary": "Review a drift trigger and optionally open a candidate cycle" } },
    "/api/v1/learning/cycle/close": { "post": { "summary": "Close learning cycle and train" } },
    "/api/v1/learning/{cycle_id}/candidates": { "post": { "summary": "Register a candidate for the cycle frozen evaluation set" } },
    "/api/v1/learning/candidate/evaluation": { "get": { "summary": "Candidate evaluation evidence and promotion gates" } },
    "/api/v1/learning/candidate/promote": { "post": { "summary": "Promote candidate" } },
    "/api/v1/learning/candidate/reject": { "post": { "summary": "Reject candidate" } },
    "/api/v1/models": { "get": { "summary": "Model management" } },
    "/api/v1/models/{model_id}/promote": { "post": { "summary": "Promote a model version outside controlled learning cycles" } },
    "/api/v1/events": { "get": { "summary": "Server-sent events" } },
    "/internal/v1/classify": { "post": { "summary": "Classification inference" } },
    "/internal/v1/embed": { "post": { "summary": "Embedding inference" } },
    "/internal/v1/forecast": { "post": { "summary": "Forecast inference" } },
    "/internal/v1/anomaly": { "post": { "summary": "Anomaly inference" } },
    "/internal/v1/training/classifier": { "post": { "summary": "Offline training" } },
    "/internal/v1/evaluation/classifier": { "post": { "summary": "Offline evaluation" } }
  }
}
