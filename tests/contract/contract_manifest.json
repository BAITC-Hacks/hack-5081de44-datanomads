{
  "version": 1,
  "api": {
    "openapi_candidates": [
      "/openapi.json",
      "/api/v1/openapi.json",
      "/docs/openapi.json"
    ],
    "health_paths": [
      "/healthz",
      "/readyz"
    ],
    "public_prefixes": [
      "/api/v1/tickets/",
      "/api/v1/assist/",
      "/api/v1/analytics/",
      "/api/v1/alerts/",
      "/api/v1/forecast/",
      "/api/v1/reports/",
      "/api/v1/learning/",
      "/api/v1/models/"
    ],
    "required_operations": [
      {
        "method": "post",
        "path": "/api/v1/assist/preview",
        "description": "First vertical slice must expose assist preview"
      }
    ],
    "internal_exact_operations": [
      {
        "method": "post",
        "path": "/internal/v1/classify"
      },
      {
        "method": "post",
        "path": "/internal/v1/embed"
      },
      {
        "method": "post",
        "path": "/internal/v1/forecast"
      },
      {
        "method": "post",
        "path": "/internal/v1/anomaly"
      }
    ],
    "internal_prefixes": [
      "/internal/v1/training/",
      "/internal/v1/evaluation/"
    ],
    "learning_actions": {
      "collect": ["collect", "feedback", "ingest"],
      "train": ["train", "training"],
      "evaluate": ["evaluate", "evaluation", "assess"],
      "promote": ["promote", "promotion"],
      "reject": ["reject", "rejection"]
    }
  },
  "roles": {
    "OPERATOR": ["tickets", "assist", "confirm", "correct", "relation_feedback"],
    "MANAGER": ["analytics", "alerts", "forecast", "reports"],
    "ML_REVIEWER": ["candidate_evaluation", "learning_cycles", "promote", "reject", "model_management"],
    "ADMIN": ["candidate_evaluation", "learning_cycles", "promote", "reject", "model_management"]
  },
  "observability": {
    "required_log_fields": [
      "timestamp",
      "level",
      "request_id",
      "trace_id",
      "service",
      "endpoint",
      "latency_ms",
      "model_version",
      "status",
      "error_code"
    ],
    "forbidden_payload_fields": [
      "full_ticket_text",
      "iin",
      "phone",
      "name",
      "full_address",
      "attachments"
    ]
  },
  "compose": {
    "file_candidates": ["docker-compose.yml", "compose.yml", "docker-compose.yaml", "compose.yaml"],
    "required_services": [
      "frontend",
      "core-api",
      "ml-service",
      "ml-worker",
      "postgres",
      "qdrant",
      "nginx"
    ],
    "demo_profile": "demo"
  },
  "fixture": {
    "path": "tests/fixtures/deterministic_demo.json",
    "minimum_regions": 20,
    "minimum_topics": 10,
    "languages": ["RU", "KZ"],
    "synthetic_marker": "is_synthetic",
