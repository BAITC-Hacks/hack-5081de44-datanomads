{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse109.local/schema/unified-ticket.v1.json",
  "title": "Pulse 109 UnifiedTicket",
  "description": "PII-minimized ticket record emitted by source importers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "external_ticket_id",
    "source_system",
    "region_id",
    "created_at",
    "original_text",
    "language",
    "topic_raw",
    "topic_id",
    "status",
    "schema_version"
  ],
  "properties": {
    "external_ticket_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_system": {"type": "string", "minLength": 1, "maxLength": 200},
    "region_id": {"type": "string", "pattern": "^KZ-[A-Z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "original_text": {"type": "string", "minLength": 1},
    "language": {"enum": ["RU", "KZ", "OTHER", "UNKNOWN"]},
    "topic_raw": {"type": "string"},
    "topic_id": {"type": "string", "minLength": 1},
    "service_raw": {"type": ["string", "null"]},
    "service_id": {"type": ["string", "null"]},
    "priority": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "OTHER", null]},
    "status": {"enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED", "CANCELLED", "OTHER", "UNKNOWN"]},
    "district": {"type": ["string", "null"]},
    "address": {"type": ["string", "null"], "description": "Only a redaction marker is allowed in the safe layer."},
    "coordinates": {"type": ["object", "null"]},
    "object": {"type": ["string", "null"]},
    "channel": {"type": ["string", "null"]},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "deadline_at": {"type": ["string", "null"], "format": "date-time"},
    "resolution_text": {"type": ["string", "null"]},
    "official_response": {"type": ["string", "null"]},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "assignment_history": {"type": "array", "items": {"type": "object"}},
    "pulse_prediction": {"type": ["object", "null"]},
    "operator_confirmed_decision": {"type": ["object", "null"]},
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "needs_review": {"type": "boolean"},
    "embedding_ref": {"type": ["string", "null"]},
    "duplicate_feedback": {"enum": ["CONFIRMED", "REJECTED", null]},
    "repeat_feedback": {"enum": ["CONFIRMED", "REJECTED", null]},
    "created_in_pulse_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_in_pulse_at": {"type": ["string", "null"], "format": "date-time"},
    "text_redaction_count": {"type": "integer", "minimum": 0},
    "schema_version": {"const": "unified-ticket.v1"}
  }
}
