# Pulse 109 local/demo defaults. Copy to .env before starting Compose.
# Replace every demo-only credential before exposing the stack outside localhost.
PULSE_ENV=demo
PULSE_HTTP_PORT=8012
# Set the public hostname (without scheme or port) when serving via Vite preview.
PULSE_PUBLIC_HOST=
# Bundled deterministic baseline. Point at a mounted manifest only after its
# runtime adapter is available.
PULSE_MODEL_MANIFEST_PATH=/app/artifacts/manifest.json

# Region × topic anomaly policy; changes are copied into each persisted alert.
PULSE_ALERT_DETECTOR_VERSION=region-topic-median-mad-v1
PULSE_ALERT_PERIOD_DAYS=7
PULSE_ALERT_BASELINE_PERIODS=4
PULSE_ALERT_MINIMUM_COUNT=3
PULSE_ALERT_ROBUST_Z_THRESHOLD=3.5
PULSE_ALERT_RATIO_THRESHOLD=1.5
PULSE_ALERT_HIGH_Z_THRESHOLD=5
PULSE_ALERT_CRITICAL_Z_THRESHOLD=7
PULSE_ALERT_HIGH_RATIO_THRESHOLD=2
PULSE_ALERT_CRITICAL_RATIO_THRESHOLD=3
PULSE_ALERT_BASELINE_FLOOR=1
PULSE_ALERT_COOLDOWN_HOURS=168
PULSE_ALERT_SEASONALITY=weekday_aligned_weekly

# Automatic learning cycles are opt-in. Production also requires a registered,
# real evaluation dataset and an active production model version.
PULSE_LEARNING_AUTO_CYCLES_ENABLED=false
PULSE_LEARNING_CYCLE_DURATION_HOURS=168
PULSE_LEARNING_MIN_FEEDBACK_COUNT=1
PULSE_LEARNING_PROMOTION_POLICY_VERSION=policy-v1
PULSE_LEARNING_EVALUATION_DATASET_VERSION=

POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_demo_only
EMBEDDING_DIMENSION=32
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDER_VERSION=embedder-demo-2026-09-21-001

# The frontend is served by the Vite container on the internal Compose network.
VITE_API_BASE_URL=/api/v1
MODEL_DIR=/app/trained-artifacts
ML_LOG_LEVEL=INFO
RUST_LOG=info
PULSE_DEV_AUTH=true
# Exact browser origins allowed by Core; comma-separate additional trusted origins.
# An empty value disables cross-origin access. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:8012

# Optional integrations are disabled by default. They must never be required
# for the core demo flow.
OPTIONAL_LLM_PROVIDER=disabled
OPTIONAL_LLM_BASE_URL=
OPTIONAL_LLM_API_KEY=
